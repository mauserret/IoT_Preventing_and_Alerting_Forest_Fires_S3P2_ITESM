[Unit]
Description=Forest IoT Telegram alerter
After=network-online.target collector.service
Wants=network-online.target

[Service]
Type=simple
User=rey
WorkingDirectory=/home/rey
EnvironmentFile=/home/rey/collector.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/rey/alerter.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
